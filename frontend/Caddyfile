{
	admin off
}

# DOMAIN задан — HTTPS с автоматическим сертификатом (DNS должен указывать на сервер).
# Не задан — просто http://:80. Камера в браузере работает только по HTTPS или на localhost.
{$DOMAIN::80} {
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv

		# index.html и sw.js без кэша: sw.js только снимает старый service worker у уже установленных клиентов
		@revalidate path / /index.html /sw.js /manifest.webmanifest
		header @revalidate Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
