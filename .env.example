# Скопировать в .env рядом и заполнить. docker compose читает его сам.

# Домен для HTTPS, DNS уже должен указывать на этот сервер.
# Пусто — фронтенд отдаётся по http://:80 без сертификата.
DOMAIN=

# Какие compose-файлы собирать. На сервере без NVIDIA оставить только compose.yml.
COMPOSE_FILE=compose.yml:compose.gpu.yml
